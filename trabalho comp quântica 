    "def norma(psi):\n",
    "    # <psi|psi> = conj(alpha)*alpha + conj(beta)*beta ; np.vdot já conjuga o primeiro vetor\n",
    "    return float(np.sqrt(np.vdot(psi, psi).real))\n",
    "\n",
    "def estado(alpha, beta):\n",
    "    v = np.array([alpha, beta], dtype=complex)\n",
    "    n = norma(v)\n",
    "    if n < TOL:\n",
    "        raise ValueError(\"Vetor nulo: (0, 0) não representa um estado quântico e não pode ser normalizado.\")\n",
    "    return v / n                      # agora |alpha|^2 + |beta|^2 = 1\n",
    "\n",
    "def aplicar(U, psi):\n",
    "    U = np.asarray(U, dtype=complex)\n",
    "    if U.shape != (2, 2):\n",
    "        raise ValueError(f\"Operador precisa ser 2x2, recebi {U.shape}.\")\n",
    "    UdU = U.conj().T @ U              # U† U  (U† = transposta conjugada)\n",
    "    if not np.allclose(UdU, np.eye(2), atol=TOL):\n",
    "        raise ValueError(f\"Operador não unitário: U†U deveria ser I, mas deu\\n{np.round(UdU, 4)}\")\n",
    "    return U @ psi\n",
    "\n",
    "def probabilidades(psi):\n",
    "    # regra de Born: p0 = |alpha|^2 , p1 = |beta|^2\n",
    "    return float(abs(psi[0])**2), float(abs(psi[1])**2)"
   ]
