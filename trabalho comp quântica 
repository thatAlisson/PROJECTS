    "def medir(psi):\n",
    "    p0, p1 = probabilidades(psi)\n",
    "    resultado = 0 if rng.random() < p0 else 1     # rng.random() é uniforme em [0, 1)\n",
    "    novo = np.zeros(2, dtype=complex)\n",
    "    novo[resultado] = psi[resultado]              # projeta: mantém só a amplitude que \"saiu\"\n",
    "    return resultado, novo / norma(novo)          # renormaliza -> |0> ou |1> (a menos de fase global)\n",
    "\n",
    "def amostrar(psi, N):\n",
    "    contagem = {0: 0, 1: 0}\n",
    "    for _ in range(N):\n",
    "        r, _ = medir(psi)        # sempre sobre o psi ORIGINAL, não sobre o estado colapsado\n",
    "        contagem[r] += 1\n",
    "    return contagem"
   ]
  },
