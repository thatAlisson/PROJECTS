    "def bloch(psi):\n",
    "    psi = psi / norma(psi)            # garante estado normalizado\n",
    "    a, b = psi\n",
    "    ab = np.conj(a) * b               # conj(alpha) * beta: guarda a fase RELATIVA\n",
    "    x = 2 * ab.real\n",
    "    y = 2 * ab.imag\n",
    "    z = abs(a)**2 - abs(b)**2\n",
    "    return float(x), float(y), float(z)\n",
    "\n",
    "s = 1/np.sqrt(2)\n",
    "tabela_bloch = [\n",
    "    (\"|0>\",               estado(1, 0),       (0, 0, 1)),\n",
    "    (\"|1>\",               estado(0, 1),       (0, 0, -1)),\n",
    "    (\"|+>\",               estado(s, s),       (1, 0, 0)),\n",
    "    (\"|->\",               estado(s, -s),      (-1, 0, 0)),\n",
    "    (\"(|0> + i|1>)/√2\",   estado(s, 1j*s),    (0, 1, 0)),\n",
    "    (\"0,6|0> + 0,8|1>\",   estado(0.6, 0.8),   (0.96, 0, -0.28)),\n",
    "]\n",
